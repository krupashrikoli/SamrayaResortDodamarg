# Contact form mail — Samrāya guest enquiries
MAILBOX=website@ghdhotels.in
CONTACT_RECIPIENT=website@ghdhotels.in
CONTACT_RECIPIENT_SAMRAYA=website@ghdhotels.in

# Prefer SMTP SSL/TLS (not FormSubmit)
CONTACT_FORM_FALLBACK=smtp
NEXT_PUBLIC_SITE_URL=https://samraya.ghdhotels.in

# GHD Hotels mail server — SSL/TLS on port 465
# SMTP_CONNECT_HOST must be the provider SMTP host (not the CDN-fronted mail.ghdhotels.in)
SMTP_HOST=mail.ghdhotels.in
SMTP_CONNECT_HOST=d16211.bom1.stableserver.net
SMTP_TLS_SERVERNAME=mail.ghdhotels.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@ghdhotels.in
SMTP_FROM=website@ghdhotels.in
SMTP_PASS="__SET_THIS_ON_THE_SERVER__"

# Optional — use SMTP_PASSWORD instead of SMTP_PASS if preferred
# SMTP_PASSWORD=

# Optional auth method override
# SMTP_AUTH_METHOD=LOGIN
